# Copy this file to .env and adjust. Never commit .env.
# There are no API keys here on purpose: all inference is local.

# --- LLM provider ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Default models (must be pulled with `ollama pull <name>`) ---
CHAT_MODEL=qwen3:8b
CODE_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=bge-m3

# --- Generation defaults ---
# Context window in tokens. Ollama truncates silently when the prompt exceeds it.
NUM_CTX=8192
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=120

# --- Storage ---
DATABASE_PATH=./data/ailab.db

# --- Server ---
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
